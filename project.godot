; Backrooms Infinity — unified Godot .NET project
config_version=5

[application]
config/name="Backrooms Infinity"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.024, 0.018, 1)

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Backrooms.Infinity"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
default_bus_layout="res://default_bus_layout.tres"
