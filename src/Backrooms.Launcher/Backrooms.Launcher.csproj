<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Backrooms.Launcher</RootNamespace>
    <AssemblyName>Backrooms.Launcher</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Backrooms.Engine/Backrooms.Engine.csproj" />
    <ProjectReference Include="../../tools/Backrooms.ContributorsGen/Backrooms.ContributorsGen.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="SDL3-CS" />
    <PackageReference Include="SDL3-CS.Windows" />
    <PackageReference Include="SDL3-CS.Linux" />
    <PackageReference Include="SDL3-CS.MacOS" />
    <PackageReference Include="SDL3-CS.Windows.Image" />
    <PackageReference Include="SDL3-CS.Linux.Image" />
    <PackageReference Include="SDL3-CS.MacOS.Image" />
    <PackageReference Include="SDL3-CS.Windows.TTF" />
    <PackageReference Include="SDL3-CS.Linux.TTF" />
    <PackageReference Include="SDL3-CS.MacOS.TTF" />
    <PackageReference Include="SDL3-CS.Windows.Mixer" />
    <PackageReference Include="SDL3-CS.Linux.Mixer" />
    <PackageReference Include="SDL3-CS.MacOS.Mixer" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../assets/common/vcrosdmonorus_vhsicons.ttf">
      <Link>assets/vcrosdmonorus_vhsicons.ttf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../assets/common/FONT-COPYRIGHT.txt">
      <Link>assets/FONT-COPYRIGHT.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../assets/launcher/**/*">
      <Link>assets/launcher/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="GenerateContributors" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <ContributorGenerator>$(MSBuildProjectDirectory)/../../tools/Backrooms.ContributorsGen/bin/$(Configuration)/net10.0/Backrooms.ContributorsGen.dll</ContributorGenerator>
      <ContributorJson>$(IntermediateOutputPath)contributors.json</ContributorJson>
      <ContributorCs>$(MSBuildProjectDirectory)/Generated/Contributors.g.cs</ContributorCs>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(ContributorGenerator)&quot; &quot;$(MSBuildProjectDirectory)/../..&quot; &quot;$(ContributorCs)&quot; &quot;$(ContributorJson)&quot;" />
  </Target>
</Project>
