<?xml version="1.0" encoding="utf-8"?>
<level name="Example Endless Offices" version="1">
  <meta>
    <entry key="author" value="example" />
    <entry key="description">Reference level pack for the XML/Lua API.</entry>
  </meta>

  <script class="init" src="scripts/init.lua" />

  <chunks size="16">
    <chunk id="office">
      <object id="floor" type="cube">
        <transform position="0 -0.5 0" scale="16 1 16" />
        <shader id="pulse" src="shaders/pulse.wgsl" enabled="true">
          <param name="strength" value="0.08" />
        </shader>
      </object>

      <object id="wall_north" type="cube">
        <transform position="0 1.5 -7.9" scale="16 3 0.2" />
      </object>

      <object id="hover_cube" type="cube">
        <transform position="0 1 0" scale="1 1 1" />
        <script event="hover" src="scripts/hover.lua" />
        <script event="click"><![CDATA[
          log.info("clicked " .. self)
          shader.reload("pulse")
        ]]></script>
      </object>
    </chunk>

    <chunk id="office_alt">
      <object id="floor_alt" type="cube">
        <transform position="0 -0.5 0" scale="16 1 16" />
      </object>

      <object id="pillar" type="cylinder">
        <transform position="3 1 3" scale="0.8 3 0.8" />
      </object>
    </chunk>
  </chunks>
</level>
